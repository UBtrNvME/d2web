@@ -2,8 +2,36 @@
 
 package d2fonts
 
-// The wasm host supplies resolved font data, so this build omits the bundled
-// Noto Color Emoji payload.
+import (
+	"sync"
+
+	"github.com/d2lang/d2/d2renderers/internal/fontface"
+)
+
+var suppliedEmoji struct {
+	sync.Mutex
+	data []byte
+}
+
+// SetBundledNotoColorEmoji lets the wasm host supply D2's pinned Noto Color
+// Emoji file, which this build does not embed. The bytes are authenticated
+// against D2's registered size and SHA-256 exactly as the native loader does,
+// so any other font is refused.
+func SetBundledNotoColorEmoji(data []byte) error {
+	canonical, err := fontface.RegisterOwnedBundledNotoColorEmoji(data)
+	if err != nil {
+		return err
+	}
+	suppliedEmoji.Lock()
+	suppliedEmoji.data = canonical
+	suppliedEmoji.Unlock()
+	return nil
+}
+
+// The wasm host supplies the payload through SetBundledNotoColorEmoji; until
+// it does, this build has none.
 func bundledNotoColorEmoji() ([]byte, error) {
-	return nil, nil
+	suppliedEmoji.Lock()
+	defer suppliedEmoji.Unlock()
+	return suppliedEmoji.data, nil
 }
