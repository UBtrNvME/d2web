    {
      "name": "shadow",
      "style": true,
      "domain": {
        "kind": "boolean"
      }
    },
    {
      "name": "shape",
      "style": false,
      "validated": true,
      "domain": {
        "kind": "enum",
        "values": [
          "rectangle",
          "square",
