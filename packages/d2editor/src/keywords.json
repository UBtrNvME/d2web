    {
      "name": "source-arrowhead",
      "style": false,
      "domain": {
        "kind": "enum",
        "values": [
          "arrow",
          "box",
          "cf-many",
          "cf-many-required",
          "cf-one",
          "cf-one-required",
          "circle",
          "cross",
          "diamond",
          "none",
          "triangle"
